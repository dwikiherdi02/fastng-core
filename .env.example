# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ─── Database driver ───────────────────────────────────────────────────────────
# Supported: sqlite | mysql | postgresql | sqlserver | mongodb
DB_DRIVER=sqlite

# ─── Prisma (sqlite / mysql / postgresql / sqlserver) ──────────────────────────
# SQLite  (default)
DATABASE_URL="file:./dev.db"

# MySQL
# DATABASE_URL="mysql://user:password@localhost:3306/FastNG"

# PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/FastNG"

# SQL Server
# DATABASE_URL="sqlserver://localhost:1433;database=FastNG;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/FastNG

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Seeder (default admin created by `yarn db:seed`) ──────────────────────────
SEED_ADMIN_EMAIL=admin@fastng.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=password

# ─── Rate limit ────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
