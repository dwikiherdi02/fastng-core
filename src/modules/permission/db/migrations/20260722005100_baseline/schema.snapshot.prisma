// Base block for DB_DRIVER=sqlite. Contains only generator + datasource.
// Module table definitions are appended from each enabled module's db/*.prisma fragment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Schema fragment owned by the `permission` module (global permission catalog).
// Self-contained: no cross-module @relation; other modules reference by scalar id.

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("permissions")
}
